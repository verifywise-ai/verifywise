# Virtual environments (these caused the 1.3GB bloat)
**/venv/
**/.venv/
**/ENV/
**/env/

# Python cache
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.Python
**/*.so
**/*.egg-info/
**/*.egg
**/.eggs/

# Node
**/node_modules/
**/.next/

# Git
.git/

# IDE
.idea/
.vscode/
**/*.swp
**/*.swo

# Logs and test artifacts
**/*.log
**/logs/
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.tox/

# OS files
**/.DS_Store
**/Thumbs.db

# Local environment files. **/.env matters for the Servers image in particular:
# it builds from this context and copies Servers/ wholesale, so without this the
# DB password, JWT secret and private keys would be baked into the image and
# flagged by Trivy's secret scanner. Keep .env.example for reference.
**/.env
**/.env.*
!**/.env.example

# Test coverage reports — rendered source, never needed at runtime.
**/coverage/

# Build output — regenerated inside the image.
Servers/dist/
MCPServer/dist/
