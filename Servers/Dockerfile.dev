FROM node:26-alpine

WORKDIR /app

# Install git for AI detection repository scanning
RUN apk add --no-cache git

COPY ./Servers/package.json ./
RUN npm install

COPY ./Servers/ ./
COPY ./Servers/SQL_Commands.sql ./SQL_Commands.sql
# npm run watch compiles the shared colour tokens from ../shared/design-tokens
COPY ./shared/design-tokens /shared/design-tokens

COPY ./Servers/templates ./dist/templates

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD node -e "require('http').get('http://localhost:3000/health', (r) => r.statusCode === 200 ? process.exit(0) : process.exit(1)).on('error', () => process.exit(1))"

CMD ["npm", "run", "watch"]
