# VerifyWise Backend — Example Environment File
# Copy to `.env` and fill in real values for local development.

# Common
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
HOST=localhost
NODE_ENV=development

MULTI_TENANCY_ENABLED=false

# Database
DB_PORT=5432
DB_HOST=localhost
DB_NAME=verifywise
DB_USER=postgres
DB_PASSWORD=postgres

# ---------------------------------------------------------------------------
# RLS Phase 2 (row-level security enforcement) — OFF by default
# ---------------------------------------------------------------------------
# Phase 2 splits database access into two roles (see
# docs/technical/security/rls-rollout.md):
#   - DB_USER/DB_PASSWORD above: the OWNER role, used for migrations and
#     super-admin/maintenance jobs.
#   - DB_APP_USER/DB_APP_PASSWORD below: the non-owner `verifywise_app`
#     runtime role (created by migration
#     20260721090000-rls-app-role.js, which requires DB_APP_PASSWORD to be
#     set when the migration runs).
# When RLS_ENFORCEMENT_ENABLED=true AND DB_APP_USER is set, the runtime
# connects as verifywise_app and every authenticated request runs inside a
# transaction with `SET LOCAL app.current_org = :orgId`, so the Phase 1 RLS
# policies enforce tenant isolation in the database itself. Keep this false
# until the Phase 2 enablement checklist in the runbook is complete (run
# migrations with the flag off so they execute as the owner role).
RLS_ENFORCEMENT_ENABLED=false
# DB_APP_USER=verifywise_app
# DB_APP_PASSWORD=replace-me-strong-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend Settings
JWT_SECRET=replace-me
REFRESH_TOKEN_SECRET=replace-me

# Secret used to HMAC-hash persisted API tokens. Must be 32+ random chars.
# Falls back to ENCRYPTION_KEY when unset, but a dedicated value is preferred.
API_TOKEN_HASH_SECRET=replace-me

# Email
EMAIL_PROVIDER=resend
EMAIL_ID=your-email@company.com
RESEND_API_KEY=your-resend-api-key

# Super-admin (seeded by migration on fresh installs)
SUPERADMIN_EMAIL=super@local.dev
SUPERADMIN_PASSWORD=Super123!

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) SSO
# ---------------------------------------------------------------------------
# Gates all /api/ssoConfig/* endpoints and the POST /api/users/login-microsoft
# handler. When SSO_ENABLED is anything other than "true", the router returns
# 404 for those routes and the frontend hides the login SSO section + the
# Settings → SSO tab. Default off — only turn on for self-hosted installs
# where admins need to configure Microsoft Entra ID.
SSO_ENABLED=false
# Required when SSO_ENABLED=true. 32+ char random string used as the key
# source for AES-256-GCM encryption of stored Azure AD client secrets.
# Generate with: openssl rand -hex 32
# SSO_SECRET=replace-me-with-32-plus-char-random-string
#
# Note: there is no redirect URI env var. The redirect URI is derived from
# the frontend's own origin at runtime (window.location.origin +
# "/auth/microsoft/callback") and round-tripped through the OAuth callback.
# Org admins are shown the exact URL to register in the Entra ID portal on
# the Settings → SSO page.

# ---------------------------------------------------------------------------
# Dev-only auto-bootstrap (DEV ONLY — hard-disabled when NODE_ENV=production)
# ---------------------------------------------------------------------------
# When DEV_AUTO_BOOTSTRAP=true and no organizations exist yet, the server will
# automatically create the first organization and an active Admin user on
# startup, so you can log in immediately on a fresh database without going
# through the super-admin onboarding flow.
#
# DEV_ADMIN_PASSWORD must satisfy backend strength rules: at least 8 chars
# and contain uppercase, lowercase, and a digit.
# DEV_AUTO_BOOTSTRAP=true
# DEV_ORG_NAME=Acme Dev
# DEV_ADMIN_EMAIL=admin@local.dev
# DEV_ADMIN_PASSWORD=Admin123!
# DEV_ADMIN_NAME=Dev
# DEV_ADMIN_SURNAME=Admin

# ---------------------------------------------------------------------------
# Langfuse — advisor/agent execution tracing (OPTIONAL)
# ---------------------------------------------------------------------------
# Leave unset to disable tracing entirely — the advisor pipeline no-ops every
# trace/span call when these keys are absent. Set all three to enable.
# LANGFUSE_HOST points at a self-hosted instance (e.g. http://langfuse:3000
# inside Docker) or https://cloud.langfuse.com for Langfuse Cloud.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Evidence Hub retention — soft-archive expired evidence in the daily sweep.
# Default off. Archival NEVER deletes records; it also requires the org's
# archive_on_expiry setting (PUT /api/evidenceHub/settings).
# EVIDENCE_RETENTION_ARCHIVE_ENABLED=false

# Server log retention — how many days of daily-rotated server log files are kept (self-hosted only).
# Default 14 days.
LOG_RETENTION_DAYS=14

# Internal service-to-service keys.
# The backend proxies /api/deepeval/* to the Eval Server and calls the AI
# Gateway's /internal/* routes using these shared secrets. Each value MUST
# match the same-named key in the target service's .env:
#   EVAL_SERVER_INTERNAL_KEY -> EvalServer/.env
#   AI_GATEWAY_INTERNAL_KEY  -> AIGateway/.env (and the root .env)
# When EVAL_SERVER_INTERNAL_KEY is missing, every /api/deepeval/* call is
# proxied with an empty key and the Eval Server answers 401.
LLM_EVALS_URL=http://127.0.0.1:8000
EVAL_SERVER_INTERNAL_KEY=
AI_GATEWAY_URL=http://127.0.0.1:8100
AI_GATEWAY_INTERNAL_KEY=

# ---------------------------------------------------------------------------
# Vendor research agent (OPTIONAL)
# ---------------------------------------------------------------------------
# A background job researches a vendor on the web and stores risk findings that
# a person later accepts or dismisses. The agent runs on the organization's own
# LLM key (Settings, API keys) and needs no other account. The server needs
# outbound HTTPS to www.bing.com (the search feed) and to public pages on any
# host that a search returns or on the vendor's own domain, all through the page
# guard of docs/technical/infrastructure/web-research.md. Without an LLM key the
# feature reports that it is not set up and nothing runs.
#
# Run research automatically after a vendor is created. Only "false" turns it
# off; people can still start a run by hand.
VENDOR_RESEARCH_AUTO_RUN=true
# Minutes a person must wait before researching the same vendor again. 0 means
# no wait. Anything but a whole number of 0 or more falls back to 10.
VENDOR_RESEARCH_MANUAL_COOLDOWN_MINUTES=10
# Research runs one organization may start in a rolling 24 hours, automatic and
# manual together. Anything but a whole number of 1 or more falls back to 50.
VENDOR_RESEARCH_DAILY_RUN_CAP=50
# Research runs one worker process carries out at the same time. Research has a
# queue and a worker of its own; this is the one setting the worker reads.
# Anything but a whole number of 1 or more falls back to 5.
VENDOR_RESEARCH_WORKER_CONCURRENCY=5
# Open a page that only a script can build (a site that is an empty shell until
# its scripts have run) in a headless Chromium, so that its text can be read.
# Only "true" turns it on; it is off by default because a browser is the heaviest
# thing research runs. Every request of the page goes through the same page
# guard as any other (see docs/technical/infrastructure/web-research.md). The
# worker reads it. Chromium comes with the published image; elsewhere, install
# it and set PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH (the PDF reports use it too).
# Run the backend as an unprivileged user to keep Chromium's own sandbox: as
# root it is started without one.
VENDOR_RESEARCH_HEADLESS=false
# Look the vendor up in the public databases of vulnerabilities, breaches and
# incident reports (the CISA catalog of known exploited vulnerabilities, the
# National Vulnerability Database, Have I Been Pwned and the filings of the SEC)
# and in the sanctions list of the US Treasury, and read the incident history on
# its status page, before the model's first step. They cost the model nothing
# and need no key or account. Only "false" turns it off, for a host that cannot
# reach www.cisa.gov, services.nvd.nist.gov, haveibeenpwned.com, www.sec.gov,
# data.sec.gov or sanctionslistservice.ofac.treas.gov (and the Amazon S3 host it
# redirects to), or the status pages of vendors (status.<domain>,
# <brand>.statuspage.io), or a policy that says no. The worker reads it (see
# docs/technical/infrastructure/web-research.md).
VENDOR_RESEARCH_RECORDS=true
# The vendor risk database: copy the CISA catalog of known exploited
# vulnerabilities (every hour) and the OFAC, UK and EU sanctions lists (every 6
# hours) into the database, look each researched vendor up in the copy instead
# of the per-run lookups of KEV and OFAC, and rate every finding with a
# credibility computed from its sources. Only "true" turns it on; it stays off
# until the golden set of research results passes. Both the backend (it
# registers the schedules at start-up) and the worker (it runs the downloads and
# the research) read it, so set it on both. VENDOR_RESEARCH_RECORDS=false stops
# the downloads too. The hosts it reaches: www.cisa.gov,
# sanctionslistservice.ofac.treas.gov (and its Amazon S3 host),
# sanctionslist.fcdo.gov.uk and webgate.ec.europa.eu.
VENDOR_RESEARCH_VRDB=false
