exports[`report-pdf.ejs: general reports renders a non-kind report byte for byte as before the E-23 report existed 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acme Vision - HIPAA Report</title>
  <style>
    /**
 * PDF Report Styles
 * Rich CSS for Playwright PDF generation
 * Uses Flexbox/Grid, print optimization
 */

/* Base Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Typography. {{color…}} is replaced from the shared palette at render time. */
:root {
  --color-primary: #14715B;
  --color-secondary: #1A2E2B;
  --color-text-primary: #1A2E2B;
  --color-text-secondary: #33453F;
  --color-text-tertiary: #495A56;
  --color-text-icon: #6B7C78;
  --color-background: #FFFFFF;
  --color-background-alt: #FAFAFA;
  --color-background-hover: #F3F6F5;
  --color-border: #E4E6E6;
  --color-success: #17703B;
  --color-success-bg: #DCF2E4;
  --color-warning: #9A4D05;
  --color-warning-bg: #FDEBD5;
  --color-error: #B91C1C;
  --color-error-bg: #FDE2E2;
  --color-info: #2D6F99;
  --color-info-bg: #E3F2FC;
  --color-risk-critical: #B91C1C;
  --color-risk-critical-bg: #FDE2E2;
  --color-risk-high: #9A4D05;
  --color-risk-high-bg: #FDEBD5;
  --color-risk-medium: #725A00;
  --color-risk-medium-bg: #FCF3C4;
  --color-risk-low: #17703B;
  --color-risk-low-bg: #DCF2E4;
  --color-risk-very-low: #495A56;
  --color-risk-very-low-bg: #EEF1F0;
  --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

body {
  font-family: var(--font-family);
  font-size: 12px;
  line-height: 1.5;
  color: var(--color-text-primary);
  background: var(--color-background);
}

/* Page Layout */
.report-container {
  width: 100%;
  max-width: 8.5in;
  margin: 0 auto;
  padding: 0.75in;
  padding-bottom: 0.75in;
}

/* Cover Page */
.cover-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  text-align: center;
}

.cover-logo {
  max-width: 200px;
  max-height: 80px;
  margin-bottom: 48px;
}

.cover-title {
  font-size: 32px;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 16px;
}

.cover-subtitle {
  font-size: 18px;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-bottom: 48px;
}

.cover-meta {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 32px;
}

.cover-meta-item {
  font-size: 14px;
  color: var(--color-text-secondary);
}

.cover-meta-item strong {
  color: var(--color-text-primary);
}

.cover-footer {
  position: absolute;
  bottom: 0.75in;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 10px;
  color: var(--color-text-tertiary);
}

/* Table of Contents */
.toc {
  page-break-after: always;
}

.toc-title {
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 24px;
  color: var(--color-text-primary);
}

.toc-list {
  list-style: none;
}

.toc-item {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 8px 0;
  border-bottom: 1px dotted var(--color-border);
}

.toc-item a {
  color: var(--color-text-primary);
  text-decoration: none;
}

.toc-item-number {
  color: var(--color-text-secondary);
  min-width: 30px;
}

/* Section Headers */
.section {
  page-break-before: always;
  margin-bottom: 32px;
}

.section:first-of-type {
  page-break-before: avoid;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--color-primary);
}

.section-icon {
  width: 32px;
  height: 32px;
  color: var(--color-primary);
}

.section-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--color-text-primary);
}

.section-subtitle {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 24px 0 16px 0;
}

/* Executive Summary */
.executive-summary {
  background: var(--color-background-alt);
  padding: 24px;
  border-radius: 8px;
  margin-bottom: 32px;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.summary-card {
  background: var(--color-background);
  padding: 16px;
  border-radius: 8px;
  border: 1px solid var(--color-border);
  text-align: center;
}

.summary-card-value {
  font-size: 28px;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 4px;
}

.summary-card-label {
  font-size: 12px;
  color: var(--color-text-secondary);
}

/* Statistics Cards */
.stats-row {
  display: flex;
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  flex: 1;
  background: var(--color-background);
  padding: 16px;
  border-radius: 8px;
  border: 1px solid var(--color-border);
}

.stat-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.stat-card-title {
  font-size: 12px;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.stat-card-value {
  font-size: 24px;
  font-weight: 700;
  color: var(--color-text-primary);
}

/* Tables */
.data-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 24px;
  font-size: 11px;
}

.data-table thead {
  background: var(--color-background-alt);
}

.data-table th {
  text-align: left;
  padding: 12px;
  font-weight: 600;
  color: var(--color-text-primary);
  border-bottom: 2px solid var(--color-border);
}

.data-table td {
  padding: 12px;
  border-bottom: 1px solid var(--color-border);
  vertical-align: top;
}

.data-table tbody tr:nth-child(even) {
  background: var(--color-background-alt);
}

.data-table tbody tr:hover {
  background: var(--color-background-hover);
}

/* Status Chips */
.chip {
  display: inline-block;
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 500;
  text-transform: uppercase;
}

.chip-success {
  background: var(--color-success-bg);
  color: var(--color-success);
}

.chip-warning {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}

.chip-error {
  background: var(--color-error-bg);
  color: var(--color-error);
}

.chip-info {
  background: var(--color-info-bg);
  color: var(--color-info);
}

.chip-default {
  background: var(--color-background-hover);
  color: var(--color-text-secondary);
}

/* Risk Level Chips */
.chip-critical {
  background: var(--color-risk-critical-bg);
  color: var(--color-risk-critical);
}

.chip-high {
  background: var(--color-risk-high-bg);
  color: var(--color-risk-high);
}

.chip-medium {
  background: var(--color-risk-medium-bg);
  color: var(--color-risk-medium);
}

.chip-low {
  background: var(--color-risk-low-bg);
  color: var(--color-risk-low);
}

/* Every risk vocabulary that reaches a chip ranks "Very high" above "High"
   (see \`levelRank\`, services/reporting/analyzers/prompts.ts) but the palette
   stopped at \`high\`. Callers strip the " risk" suffix the project/vendor
   \`risk_level_autocalculated\` enum carries before building the class name. */
.chip-very-high {
  background: var(--color-risk-critical-bg);
  color: var(--color-risk-critical);
}

.chip-very-low {
  background: var(--color-risk-very-low-bg);
  color: var(--color-risk-very-low);
}

/* Progress Bars */
.progress-bar {
  width: 100%;
  height: 8px;
  background: var(--color-border);
  border-radius: 4px;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 4px;
  transition: width 0.3s ease;
}

.progress-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4px;
  font-size: 11px;
  color: var(--color-text-secondary);
}

/* Charts Container */
.chart-container {
  width: 100%;
  height: 300px;
  margin: 24px 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.chart-placeholder {
  width: 100%;
  height: 100%;
  background: var(--color-background-alt);
  border: 1px dashed var(--color-border);
  border-radius: 8px;
  display: flex;
  justify-content: center;
  align-items: center;
  color: var(--color-text-tertiary);
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 48px 24px;
  background: var(--color-background-alt);
  border-radius: 8px;
  color: var(--color-text-secondary);
}

.empty-state-icon {
  width: 48px;
  height: 48px;
  margin-bottom: 16px;
  opacity: 0.5;
}

.empty-state-title {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--color-text-primary);
}

.empty-state-text {
  font-size: 13px;
  color: var(--color-text-secondary);
  margin: 0;
}

/* A short line under a table, e.g. how many archived incidents were left out */
.subsection-note {
  font-size: 12px;
  color: var(--color-text-secondary);
  margin: 8px 0 0;
}

/* Page Header/Footer for print */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 24px;
  font-size: 10px;
  color: var(--color-text-secondary);
}

.page-header-logo {
  max-height: 24px;
}

.page-footer {
  margin-top: 48px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12px;
  border-top: 1px solid var(--color-border);
  font-size: 10px;
  color: var(--color-text-tertiary);
}

/* Print Optimization */
@media print {
  body {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .section {
    page-break-before: always;
  }

  .section:first-of-type {
    page-break-before: avoid;
  }

  .data-table {
    page-break-inside: auto;
  }

  .data-table tr {
    page-break-inside: avoid;
    page-break-after: auto;
  }

  .data-table thead {
    display: table-header-group;
  }

  .no-print {
    display: none !important;
  }

  .page-break-before {
    page-break-before: always;
  }

  .page-break-after {
    page-break-after: always;
  }

  .avoid-break {
    page-break-inside: avoid;
  }
}

/* Responsive adjustments for smaller paper */
@media print and (max-width: 6in) {
  .summary-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .stats-row {
    flex-direction: column;
  }
}

/* Sections with no data (section notices) */
.section-notice-intro {
  font-size: 11px;
  color: var(--color-text-icon);
  margin-bottom: 8px;
}

.section-notice {
  font-size: 12px;
  color: var(--color-text-secondary);
  padding-left: 18px;
}

.section-notice li {
  margin-bottom: 4px;
}


    /* Custom branding colors */
    :root {
      --color-primary: #13715B;
    }

    /* Section headings: plain bold text, sentence case */
    .group-header {
      margin: 32px 0 16px 0;
    }

    .group-title {
      font-size: 18px;
      font-weight: 700;
      color: var(--color-text-primary);
      margin: 0;
    }

    .subsection {
      margin-bottom: 32px;
    }

    .subsection:last-child {
      margin-bottom: 60px;
    }

    .subsection-header {
      margin-bottom: 16px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--color-border);
    }

    .subsection-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--color-text-primary);
      margin: 0;
    }

    /* AI Analysis Styles */
    .ai-analysis-box {
      border-left: 4px solid var(--color-primary);
      background: #f0faf7;
      padding: 16px 20px;
      margin: 16px 0 24px 0;
      border-radius: 0 4px 4px 0;
    }
    .ai-analysis-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--color-primary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }
    .ai-analysis-content {
      font-size: 12px;
      line-height: 1.6;
      color: #344054;
      white-space: pre-wrap;
    }
    .ai-risk-highlights-box {
      border-left: 4px solid #DC6803;
      background: #fffcf5;
      padding: 16px 20px;
      margin: 16px 0 24px 0;
      border-radius: 0 4px 4px 0;
    }
    /* Page-break avoidance sits on the individual finding, never on the whole
       AI block: an executive summary plus eight findings is taller than a
       page, and avoiding a break on a block that cannot fit only pushes a
       blank page ahead of it. The executive-summary wrapper div in the body
       keeps its class — it is the block's structural hook — it just no
       longer carries a break rule. */
    .ai-findings-list {
      padding-left: 20px;
      margin: 8px 0;
    }
    .ai-findings-list li {
      margin-bottom: 6px;
      font-size: 12px;
      color: #344054;
      page-break-inside: avoid;
    }
    .ai-finding {
      page-break-inside: avoid;
      margin: 0 0 12px 0;
      padding-left: 10px;
      border-left: 2px solid var(--color-border);
    }
    .ai-finding-text {
      font-size: 12px;
      line-height: 1.5;
      color: #344054;
    }
    .ai-finding-meta {
      font-size: 10px;
      color: #667085;
      margin-top: 3px;
    }
  </style>
</head>
