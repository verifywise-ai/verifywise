{
  "name": "verifywise",
  "version": "1.7.0",
  "main": "index.js",
  "scripts": {
    "test:unit": "jest --testPathIgnorePatterns=/tests/integration/ --testPathIgnorePatterns=/helpers/ --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=/tests/integration/ --testPathIgnorePatterns=/helpers/ --detectOpenHandles --forceExit",
    "test:smoke": "jest --config jest.config.js --globalSetup=\"<rootDir>/tests/integration/globalSetup.js\" --testPathPatterns=deadline-summary --runInBand",
    "test:ratelimit": "jest --config jest.config.js --testMatch=\"**/tests/integration/rate-limiting/**/*.test.ts\" --testPathIgnorePatterns=/helpers/ --testPathIgnorePatterns=limiter-wiring --runInBand --forceExit",
    "smoke:api-contract": "ts-node --transpile-only scripts/apiContractSmoke.ts",
    "generate:enum-manifest": "ts-node --transpile-only scripts/generateEnumManifest.ts",
    "check:enum-drift": "npm run generate:enum-manifest && ts-node --transpile-only scripts/checkEnumLabelDrift.ts",
    "test": "npm run test:unit",
    "test:watch": "jest --watch",
    "test:integration": "node --max-old-space-size=8192 node_modules/jest/bin/jest.js --config jest.config.js --globalSetup=\"<rootDir>/tests/integration/globalSetup.js\" --testMatch=\"**/tests/integration/**/*.test.ts\" --runInBand",
    "build:tokens": "tsc -p ../shared/design-tokens/tsconfig.json --outDir tools/design-tokens",
    "prebuild": "npm run build:tokens",
    "build": "tsc",
    "start": "npm run migrate-db && node dist/index.js",
    "postbuild": "node scripts/copyFiles.js",
    "postinstall": "patch-package",
    "migrate-db": "npx sequelize db:migrate --debug",
    "worker": "node dist/jobs/worker.js",
    "watch": "npm run build:tokens && tsc-watch --noClear --onSuccess \"npm-run-all postbuild --parallel start worker\"",
    "reset-db": "ts-node scripts/resetDatabase.ts",
    "seed:demo": "ts-node scripts/seeds/demo.ts",
    "seed:demo:reset": "ts-node scripts/seeds/demo.ts --reset",
    "seed:demo:delete": "ts-node scripts/seeds/demo.ts --delete",
    "seed:demo-org": "ts-node scripts/seeds/demoOrg.ts",
    "seed:demo-org:reset": "ts-node scripts/seeds/demoOrg.ts --reset",
    "seed:incidents": "ts-node scripts/seeds/incidents.ts",
    "seed:automation-logs": "ts-node scripts/seeds/automationLogs.ts",
    "seed:e2e": "ts-node scripts/seedTestData.ts",
    "generate-dbml": "node scripts/generateDbml.js",
    "generate:swagger": "ts-node scripts/generateSwagger.ts",
    "generate:endpoints": "ts-node scripts/generateEndpointsTs.ts",
    "check:api-drift": "ts-node scripts/checkApiDrift.ts",
    "migrate:shared-schema": "ts-node scripts/migrateToSharedSchema.ts",
    "i18n:extract": "node scripts/extract-i18n-keys.mjs",
    "i18n:translate": "node scripts/translate-with-glossary.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:audit:strict": "node scripts/i18n-audit.mjs --strict",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "node -e \"try { require('fs').accessSync('.git'); require('child_process').spawnSync('husky', {stdio: 'inherit', shell: true}); } catch(e) {}\""
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
