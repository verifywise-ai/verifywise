**/node_modules/

# Local environment files (keep .env.example for reference).
# Prevents secrets (DB passwords, JWT secret, private keys) from being baked
# into the image via `COPY ./ ./` and flagged by Trivy's secret scanner.
**/.env
**/.env.local
**/.env.*
!**/.env.example

# Test coverage reports — contain rendered source (incl. token examples) and
# are never needed at runtime.
**/coverage/

# Build output — regenerated by `npm run build` inside the image.
dist/

# VCS, logs, and OS cruft.
.git/
**/*.log
**/.DS_Store
