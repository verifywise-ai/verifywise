<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">AI Gateway configuration change</h2><p class="email-body">Hi {{recipient_name}},</p><p class="email-body">{{change_description}}</p><div class="box box-primary"><p class="box-title">{{entity_type}}: {{entity_name}}</p>
                <p class="box-subtitle">{{change_detail}}</p></div><table class="data-table">
                <tr><td class="data-label">Changed by</td><td class="data-value">{{changed_by}}</td></tr>
                <tr><td class="data-label">Time</td><td class="data-value">{{changed_at}}</td></tr>
                </table><p style="margin: 28px 0 24px 0;"><a href="{{action_url}}" class="btn btn-primary">{{action_label}}</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>