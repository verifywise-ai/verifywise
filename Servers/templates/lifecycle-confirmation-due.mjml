<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Is "{{entry_title}}" still live?</h2><p class="email-body">Hi {{recipient_name}},</p><p class="email-body">You own the {{entry_noun}} <strong>{{entry_title}}</strong>. It has not been confirmed as live since <strong>{{since}}</strong>, and your organization asks owners to confirm every {{interval_days}} days.</p><p class="email-body">Open it and choose <strong>Confirm still live</strong>. If it is no longer in use, retire it instead.</p><p style="margin: 28px 0 24px 0;"><a href="{{entry_url}}" class="btn btn-info">Open {{entry_noun}}</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
