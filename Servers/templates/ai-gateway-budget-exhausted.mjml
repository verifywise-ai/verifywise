<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">AI Gateway budget exhausted</h2><p class="email-body">Hi {{recipient_name}},</p><p class="email-body">Your AI Gateway has reached its monthly spending limit. <strong>All requests are now being rejected</strong> because the hard limit is enabled.</p><div class="box box-error"><p class="box-status-error">Spend: ${{current_spend}} / ${{monthly_limit}}</p>
                <p class="box-subtitle">Requests are being rejected with HTTP 429</p></div><p class="email-body"><strong>To restore service:</strong></p><ul><li>Increase the monthly budget limit</li><li>Disable the hard limit (requests will continue but overage is tracked)</li><li>Wait for the automatic monthly reset on the 1st</li></ul><p style="margin: 28px 0 24px 0;"><a href="{{settings_url}}" class="btn btn-error">Update budget</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>