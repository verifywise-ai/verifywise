<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">New training assigned</h2><p class="email-body">Hi {{trainee_name}},</p><p class="email-body">You have been assigned to complete the following training.</p><div class="box box-warning"><p class="box-title">{{training_name}}</p>
                <p class="box-subtitle">{{training_description}}</p></div><table class="data-table">
                <tr><td class="data-label">Duration</td><td class="data-value">{{training_duration}}</td></tr>
                <tr><td class="data-label">Due date</td><td class="data-value">{{training_due_date}}</td></tr>
                </table><p style="margin: 28px 0 24px 0;"><a href="{{training_url}}" class="btn btn-warning">Start training</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>