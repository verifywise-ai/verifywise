<mjml>
<mj-head>
  <mj-font name="Inter" href="https://fonts.googleapis.com/css?family=Inter:400,500,600"></mj-font>
  <mj-attributes>
    <mj-all font-family="Geist, Inter, system-ui, -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif" color="#344054"></mj-all>
    <mj-text font-size="15px" line-height="24px" color="#344054" padding="0"></mj-text>
    <mj-section padding="0px"></mj-section>
    <mj-column padding="0px"></mj-column>
    <mj-button background-color="#13715B" color="#ffffff" border-radius="4px" font-size="14px" font-weight="500" padding="0" height="44px"></mj-button>
  </mj-attributes>
  <mj-style inline="inline">
    .email-card { background-color: #ffffff; border: 1px solid #eaecf0; border-radius: 10px; overflow: hidden; }
    .email-heading { color: #1c2130; font-size: 22px; font-weight: 600; line-height: 1.35; margin: 0 0 24px 0; letter-spacing: -0.2px; }
    .email-body { color: #344054; font-size: 15px; line-height: 24px; margin: 0 0 20px 0; }
    .email-muted { color: #475467; font-size: 14px; line-height: 22px; margin: 0; }
    .email-footer { color: #838c99; font-size: 13px; line-height: 20px; text-align: center; }
    .box { padding: 20px; border-radius: 6px; margin: 24px 0; }
    .box-info { background-color: #f9fafb; }
    .box-success { background-color: #E6F4EA; }
    .box-error { background-color: #FFD6D6; }
    .box-warning { background-color: #FFF8E1; }
    .box-primary { background-color: #E6F0EC; }
    .box-title { color: #1c2130; font-weight: 600; font-size: 15px; margin: 0 0 10px 0; }
    .box-subtitle { color: #475467; font-size: 14px; line-height: 22px; margin: 0; }
    .box-status-success { color: #138A5E; font-size: 14px; font-weight: 600; margin: 0; }
    .box-status-error { color: #D32F2F; font-size: 14px; font-weight: 600; margin: 0; }
    .data-table { width: 100%; font-size: 14px; border-collapse: collapse; margin: 24px 0; }
    .data-table td { padding: 10px 0; vertical-align: top; }
    .data-label { color: #475467; width: 140px; padding-right: 20px; }
    .data-value { color: #1c2130; font-weight: 500; }
    ul { margin: 0 0 20px 0; padding-left: 24px; color: #344054; }
    li { margin-bottom: 10px; line-height: 22px; }
    a { color: #13715B; text-decoration: none; }
    .btn { display: inline-block; padding: 12px 24px; border-radius: 4px; text-decoration: none; font-size: 14px; font-weight: 500; color: #ffffff; }
    .btn-primary { background-color: #13715B; }
    .btn-success { background-color: #138A5E; }
    .btn-error { background-color: #D32F2F; }
    .btn-warning { background-color: #795548; }
    .btn-info { background-color: #1565C0; }
    .spacer { height: 8px; }
  </mj-style>
</mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: #13715B; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">AI Gateway risk suggestions</h2><p class="email-body">Hi {{recipient_name}},</p><p class="email-body">{{suggestion_count}} new risk suggestion(s) were detected in your AI Gateway based on recent monitoring data.</p><table style="width: 100%; margin: 24px 0; border-collapse: collapse;">
                  {{suggestion_rows}}
                </table><p style="margin: 28px 0 24px 0;"><a href="{{gateway_url}}" class="btn btn-primary">Review in VerifyWise</a></p><p class="email-muted">You can adjust detection thresholds or disable conditions in Settings &gt; Suggested risks.</p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>