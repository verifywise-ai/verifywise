<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Reset your password</h2><p class="email-body">Hello {{name}},</p><p class="email-body">You are receiving this email because a password reset request was made for <strong>{{email}}</strong>.</p><p class="email-body">Click the button below to reset your password.</p><p style="margin: 28px 0 24px 0;"><a href="{{url}}" class="btn btn-primary">Reset password</a></p><p class="email-body">If you did not request this, please ignore this email. Your password will remain unchanged.</p><p class="email-body">Thank you.</p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>