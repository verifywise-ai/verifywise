<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">AI Gateway budget warning</h2><p class="email-body">Hi {{recipient_name}},</p><p class="email-body">Your AI Gateway spend has reached <strong>{{spend_percentage}}%</strong> of the monthly budget.</p><div class="box box-warning"><p class="box-title">Current spend: ${{current_spend}}</p>
                <p class="box-subtitle">Monthly limit: ${{monthly_limit}}</p></div><table class="data-table">
                <tr><td class="data-label">Alert threshold</td><td class="data-value">{{threshold}}%</td></tr>
                <tr><td class="data-label">Hard limit</td><td class="data-value">{{hard_limit_status}}</td></tr>
                <tr><td class="data-label">Total requests</td><td class="data-value">{{total_requests}}</td></tr>
                </table><p style="margin: 28px 0 24px 0;"><a href="{{gateway_url}}" class="btn btn-primary">View analytics</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>