<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Your role has been updated on {{project_name}}</h2><p class="email-body">Hi {{user_name}},</p><p class="email-body">Your role on <strong>{{project_name}}</strong> has been changed from <strong>editor</strong> to <strong>admin</strong> by {{actor_name}}.</p><p class="email-body">You now have full admin permissions for members, policies, and controls.</p><p style="margin: 28px 0 24px 0;"><a href="{{project_url}}" class="btn btn-primary">Open project</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>