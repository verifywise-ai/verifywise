<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Vendor review due soon</h2><p class="email-body">Hi {{reviewer_name}},</p><p class="email-body">A vendor you are assigned to review has a review date coming up.</p><div class="box box-warning"><p class="box-title">{{vendor_name}}</p>
                <p class="box-subtitle">Review due: {{review_date}}</p></div><table class="data-table">
                <tr><td class="data-label">Risk level</td><td class="data-value">{{risk_level}}</td></tr>
                <tr><td class="data-label">Last reviewed</td><td class="data-value">{{last_review_date}}</td></tr>
                <tr><td class="data-label">Projects</td><td class="data-value">{{project_count}} project(s)</td></tr>
                </table><p class="email-body"><strong>Next steps:</strong></p><ul><li>Review vendor documentation</li><li>Check compliance status</li><li>Update risk assessment if needed</li><li>Complete the review checklist</li></ul><p style="margin: 28px 0 24px 0;"><a href="{{vendor_url}}" class="btn btn-warning">Review vendor</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>