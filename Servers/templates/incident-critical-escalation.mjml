<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Critical incident needs a response</h2><p class="email-body">Hi {{admin_name}},</p><p class="email-body">An incident in your organization was rated critical. As an Admin, you are asked to review it and coordinate the response.</p><div class="box box-error"><p class="box-title">{{incident_reference}}</p>
                <p class="box-subtitle">Severity: {{severity}}</p></div><table class="data-table">
                <tr><td class="data-label">Use case</td><td class="data-value">{{use_case}}</td></tr>
                <tr><td class="data-label">Type</td><td class="data-value">{{incident_type}}</td></tr>
                <tr><td class="data-label">Owner</td><td class="data-value">{{owner_name}}</td></tr>
                </table><p style="margin: 28px 0 24px 0;"><a href="{{incident_url}}" class="btn btn-error">Open incident</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
