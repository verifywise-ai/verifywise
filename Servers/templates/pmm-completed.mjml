<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Post-market monitoring completed</h2><p class="email-body">Hi {{stakeholder_name}},</p><p class="email-body">The post-market monitoring for <strong>{{use_case_title}}</strong> (Cycle #{{cycle_number}}) has been successfully completed.</p><div class="box box-success"><p class="box-subtitle" style="margin-bottom: 6px;"><strong>Completed by:</strong> {{completed_by_name}}</p>
                <p class="box-subtitle" style="margin-bottom: 6px;"><strong>Completed on:</strong> {{completed_at}}</p>
                <p class="box-subtitle"><strong>Flagged concerns:</strong> {{flagged_count}}</p></div><p class="email-body">A PDF report has been generated and is attached to this email for your records. This report documents the compliance status at the time of monitoring and can be used for audit purposes.</p><p class="email-body"><strong>Next monitoring cycle:</strong></p><p class="email-body">The next monitoring cycle will be due on <strong>{{next_due_date}}</strong>. You will receive a notification when it is time to complete the next review.</p><p style="margin: 28px 0 24px 0;"><a href="{{report_link}}" class="btn btn-primary">View report archive</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>