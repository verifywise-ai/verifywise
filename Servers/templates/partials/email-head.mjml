<mj-head>
  <mj-font name="Inter" href="https://fonts.googleapis.com/css?family=Inter:400,500,600"></mj-font>
  <mj-attributes>
    <mj-all font-family="Geist, Inter, system-ui, -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif" color="{{colorTextSecondary}}"></mj-all>
    <mj-text font-size="15px" line-height="24px" color="{{colorTextSecondary}}" padding="0"></mj-text>
    <mj-section padding="0px"></mj-section>
    <mj-column padding="0px"></mj-column>
    <mj-button background-color="{{colorButtonPrimary}}" color="{{colorButtonText}}" border-radius="4px" font-size="14px" font-weight="500" padding="0" height="44px"></mj-button>
  </mj-attributes>
  <mj-style inline="inline">
    .email-card { background-color: {{colorBackground}}; border: 1px solid {{colorBorderLight}}; border-radius: 10px; overflow: hidden; }
    .email-heading { color: {{colorTextPrimary}}; font-size: 22px; font-weight: 600; line-height: 1.35; margin: 0 0 24px 0; letter-spacing: -0.2px; }
    .email-body { color: {{colorTextSecondary}}; font-size: 15px; line-height: 24px; margin: 0 0 20px 0; }
    .email-muted { color: {{colorTextTertiary}}; font-size: 14px; line-height: 22px; margin: 0; }
    .email-footer { color: {{colorTextAccent}}; font-size: 13px; line-height: 20px; text-align: center; }
    .box { padding: 20px; border-radius: 6px; margin: 24px 0; }
    .box-info { background-color: {{colorBackgroundAlt}}; }
    .box-success { background-color: {{colorSuccessBg}}; }
    .box-error { background-color: {{colorErrorBg}}; }
    .box-warning { background-color: {{colorWarningBg}}; }
    .box-primary { background-color: {{colorBrandPrimaryLight}}; }
    .box-title { color: {{colorTextPrimary}}; font-weight: 600; font-size: 15px; margin: 0 0 10px 0; }
    .box-subtitle { color: {{colorTextTertiary}}; font-size: 14px; line-height: 22px; margin: 0; }
    .box-status-success { color: {{colorSuccessText}}; font-size: 14px; font-weight: 600; margin: 0; }
    .box-status-error { color: {{colorErrorText}}; font-size: 14px; font-weight: 600; margin: 0; }
    .data-table { width: 100%; font-size: 14px; border-collapse: collapse; margin: 24px 0; }
    .data-table td { padding: 10px 0; vertical-align: top; }
    .data-label { color: {{colorTextTertiary}}; width: 140px; padding-right: 20px; }
    .data-value { color: {{colorTextPrimary}}; font-weight: 500; }
    ul { margin: 0 0 20px 0; padding-left: 24px; color: {{colorTextSecondary}}; }
    li { margin-bottom: 10px; line-height: 22px; }
    a { color: {{colorBrandPrimary}}; text-decoration: none; }
    .btn { display: inline-block; padding: 12px 24px; border-radius: 4px; text-decoration: none; font-size: 14px; font-weight: 500; color: {{colorButtonText}}; }
    .btn-primary { background-color: {{colorButtonPrimary}}; }
    .btn-success { background-color: {{colorButtonSuccess}}; }
    .btn-error { background-color: {{colorButtonError}}; }
    .btn-warning { background-color: {{colorButtonWarning}}; }
    .btn-info { background-color: {{colorButtonInfo}}; }
    .spacer { height: 8px; }
  </mj-style>
</mj-head>
