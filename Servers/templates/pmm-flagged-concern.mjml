<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Concern flagged: {{use_case_title}}</h2><p class="email-body">Hi {{recipient_name}},</p><p class="email-body">A concern has been flagged during the post-market monitoring for <strong>{{use_case_title}}</strong> (Cycle #{{cycle_number}}).</p><div class="box box-error"><p class="box-subtitle" style="margin-bottom: 6px;"><strong>Flagged by:</strong> {{stakeholder_name}}</p>
                <p class="box-subtitle"><strong>Date:</strong> {{flagged_at}}</p></div><p class="email-body"><strong>Flagged items:</strong></p><div style="background-color: {{colorBackgroundAlt}}; padding: 20px; border-radius: 6px; margin: 20px 0;">
                  {{flagged_questions_html}}
                </div><p class="email-body">Please review the flagged concerns and take appropriate action to address any compliance issues.</p><p style="margin: 28px 0 24px 0;"><a href="{{monitoring_link}}" class="btn btn-error">Review concerns</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>