<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Escalation: Post-market monitoring overdue</h2><p class="email-body">Hi {{escalation_contact_name}},</p><p class="email-body">This is an escalation notice regarding the post-market monitoring for <strong>{{use_case_title}}</strong> (Cycle #{{cycle_number}}).</p><div class="box box-error"><p class="box-subtitle" style="margin-bottom: 6px;"><strong>Status:</strong> Overdue by {{days_overdue}} days</p>
                <p class="box-subtitle" style="margin-bottom: 6px;"><strong>Assigned to:</strong> {{stakeholder_name}} ({{stakeholder_email}})</p>
                <p class="box-subtitle"><strong>Original due date:</strong> {{due_date}}</p></div><p class="email-body">The assigned stakeholder has not completed the required post-market monitoring questionnaire within the expected timeframe.</p><p class="email-body"><strong>Recommended actions:</strong></p><ul><li>Contact the assigned stakeholder to understand any blockers</li><li>Reassign the monitoring to another team member if necessary</li><li>Complete the monitoring yourself if urgent</li></ul><p style="margin: 28px 0 24px 0;"><a href="{{monitoring_link}}" class="btn btn-error">View monitoring</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>