<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <!-- heading, greeting, intro, instruction, button, ignore, thanks, link --><h2 class="email-heading">{{heading}}</h2><p class="email-body">{{greeting}}</p><p class="email-body">{{intro}}</p><p class="email-body">{{instruction}}</p><p style="margin: 28px 0 24px 0;"><a href="{{link}}" class="btn btn-primary">{{button}}</a></p><p class="email-body">{{ignore}}</p><p class="email-body">{{thanks}}</p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          {{footer}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>