<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">"{{file_name}}" is expiring soon</h2><p class="email-body">Hi {{recipient_name}},</p><p class="email-body">The file <strong>{{file_name}}</strong> is set to expire on <strong>{{expiry_date}}</strong> ({{days_remaining}} remaining).</p><p class="email-body"><strong>Recommended next steps:</strong></p><ul><li>Upload a refreshed version, or</li><li>Extend the expiry date / update the retention policy if the file is still valid</li></ul><p style="margin: 28px 0 24px 0;"><a href="{{file_url}}" class="btn btn-warning">Open File</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
