<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Approval requested — Step {{step_number}}</h2><p class="email-body">Hi {{approver_name}},</p><p class="email-body">You have been assigned as an approver for the following use case. Please review the details and take action.</p><div class="box box-info"><p class="box-title">{{use_case_name}}</p>
                <p class="box-subtitle">Requested by: {{requester_name}}</p></div><table class="data-table">
                <tr><td class="data-label">Workflow</td><td class="data-value">{{workflow_name}}</td></tr>
                <tr><td class="data-label">Current step</td><td class="data-value">Step {{step_number}} of {{total_steps}}</td></tr>
                </table><p style="margin: 28px 0 24px 0;"><a href="{{approval_url}}" class="btn btn-primary">Review and approve</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>