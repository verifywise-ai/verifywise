<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">You&apos;ve been assigned as {{role_type}}</h2><p class="email-body">Hi {{recipient_name}},</p><p class="email-body"><strong>{{assigner_name}}</strong> has assigned you as <strong>{{role_type}}</strong> for the following {{entity_type}}.</p><div class="box box-info"><p class="box-title" style="font-size: 16px;">{{entity_name}}</p>
                <p class="box-subtitle" style="margin-bottom: 16px;">{{entity_type}}</p>
                {{entity_context_html}}
                <div style="border-top: 1px solid {{colorBorderLight}}; margin-top: 16px; padding-top: 16px;">
                  <table class="data-table" style="margin: 0;">
                    <tr><td class="data-label">Assigned on</td><td class="data-value">{{assignment_date}}</td></tr>
                    <tr><td class="data-label">Assigned by</td><td class="data-value">{{assigner_name}}</td></tr>
                    <tr><td class="data-label">Your role</td><td class="data-value">{{role_type}}</td></tr>
                  </table>
                </div></div><div class="box box-primary"><p class="box-subtitle" style="color: {{colorBrandPrimary}}; font-weight: 500;">{{role_description}}</p></div><p style="margin: 28px 0 24px 0;"><a href="{{entity_url}}" class="btn btn-primary">View {{entity_type}}</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>