<%#
  The internal OSFI E-23 fix-it list (spec 8.6), the second file of an E-23
  run. Content comes from fixIt (services/reporting/e23/fixItView.ts); the
  layout reuses the formal report's cover and section partials. The internal
  marking in every page footer is Chromium's footer template
  (fixItFooterTemplate in pdfGenerator.ts), not part of this page.
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= fixIt.institution %> - <%= fixIt.cover.title %></title>
  <style>
    <%- include('./styles/pdf.css') %>

    :root {
      --color-primary: <%= branding.primaryColor || '{{colorBrandPrimary}}' %>;
    }
  </style>
  <style><%- include('./styles/e23.css') %></style>
</head>
<body>
  <div class="report-container">
    <%- e23Partial('cover', { coverInstitution: fixIt.institution, cover: fixIt.cover }) %>
    <%- e23Partial('sections', { e23Sections: fixIt.sections }) %>
  </div>
</body>
</html>
