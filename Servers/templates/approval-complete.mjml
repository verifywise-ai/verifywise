<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Your use case has been fully approved</h2><p class="email-body">Hi {{requester_name}},</p><p class="email-body">Congratulations. Your use case has completed all approval steps and is now fully approved.</p><div class="box box-success"><p class="box-title">{{use_case_name}}</p>
                <p class="box-status-success">All {{total_steps}} approval steps completed</p></div><p style="margin: 28px 0 24px 0;"><a href="{{use_case_url}}" class="btn btn-success">View use case</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>