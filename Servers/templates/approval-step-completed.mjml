<mjml>
<mj-include path="./partials/email-head.mjml" />
  <mj-body background-color="{{colorPageBackground}}">
    <mj-section padding="32px 20px 20px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 24px 0">
          <span style="color: {{colorBrandPrimary}}; font-size: 22px; font-weight: 600; letter-spacing: -0.5px;">VerifyWise</span>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper css-class="email-card" padding="40px">
      <mj-section>
        <mj-column width="100%">
          <mj-text>
                <h2 class="email-heading">Approval progress update</h2><p class="email-body">Hi {{requester_name}},</p><p class="email-body">Good news. Step {{completed_step}} of your approval request has been completed.</p><div class="box box-success"><p class="box-title">{{request_name}}</p>
                <p class="box-status-success">Step {{completed_step}} of {{total_steps}} completed</p></div><table class="data-table">
                <tr><td class="data-label">Approved by</td><td class="data-value">{{approver_name}}</td></tr>
                <tr><td class="data-label">Workflow</td><td class="data-value">{{workflow_name}}</td></tr>
                <tr><td class="data-label">Next step</td><td class="data-value">Step {{next_step}} — awaiting approval</td></tr>
                </table><p style="margin: 28px 0 24px 0;"><a href="{{request_url}}" class="btn btn-success">View progress</a></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="32px 20px">
      <mj-column width="100%">
        <mj-text css-class="email-footer" align="center">
          Sent with care from VerifyWise
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>