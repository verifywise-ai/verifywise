# Managed by Ansible — do not edit by hand
BACKEND_PORT={{ backend_port }}
FRONTEND_PORT={{ frontend_port }}
NODE_ENV={{ node_env }}
MULTI_TENANCY_ENABLED={{ multi_tenancy_enabled }}
HOST={{ host  }}
FRONTEND_URL={{ frontend_url }}

# Shadow AI syslog listener (off by default)
SHADOW_AI_SYSLOG_ENABLED={{ shadow_ai_syslog_enabled | default('false') }}
SHADOW_AI_SYSLOG_PORT={{ shadow_ai_syslog_port | default('6514') }}
SHADOW_AI_SYSLOG_ALLOW_PLAINTEXT={{ shadow_ai_syslog_allow_plaintext | default('false') }}
SHADOW_AI_SYSLOG_ALLOW_IP_ONLY={{ shadow_ai_syslog_allow_ip_only | default('false') }}
{% if shadow_ai_syslog_tls_cert_file | default('') %}
SHADOW_AI_SYSLOG_TLS_CERT_FILE={{ shadow_ai_syslog_tls_cert_file }}
SHADOW_AI_SYSLOG_TLS_KEY_FILE={{ shadow_ai_syslog_tls_key_file | default('') }}
{% endif %}

# Database
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_SSL={{ db_ssl | default('false') }}

# Super-admin
SUPERADMIN_EMAIL={{ superadmin_email }}
SUPERADMIN_PASSWORD={{ superadmin_password }}

# Secrets
JWT_SECRET={{ jwt_secret }}
REFRESH_TOKEN_SECRET={{ refresh_token_secret }}
ENCRYPTION_KEY={{ encryption_key }}
AI_GATEWAY_INTERNAL_KEY={{ ai_gateway_internal_key }}
EVAL_SERVER_INTERNAL_KEY={{ eval_server_internal_key }}
ENCRYPTION_ALGORITHM={{ encryption_algorithm | default('aes-256-cbc') }}
ENCRYPTION_PASSWORD={{ encryption_password }}

# Slack integration (OAuth exchange happens server-side)
SLACK_CLIENT_ID={{ slack_client_id | default('') }}
SLACK_CLIENT_SECRET={{ slack_client_secret | default('') }}
SLACK_API_URL={{ slack_api_url | default('https://slack.com/api/oauth.v2.access') }}

# Email (Resend)
EMAIL_PROVIDER=resend
EMAIL_ID={{ email_id }}
RESEND_API_KEY={{ resend_api_key }}

# Observability — RS256 push-token signing key (single-line PEM, real newlines as \n).
# Optional: leave empty to disable observability token signing on this deployment.
OBSERVABILITY_PRIVATE_KEY="{{ observability_private_key | default('') }}"
