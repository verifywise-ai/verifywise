{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "VerifyWise — Requests by deployment",
  "uid": "vw-requests",
  "tags": ["verifywise", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_requests_total, deployment)", "refId": "vw-deployments" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_requests_total{deployment=~\"$deployment\"}, service_name)", "refId": "vw-services" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (deployment, service_name) (rate(http_server_requests_total{deployment=~\"$deployment\", service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{deployment}} / {{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx, req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (deployment, service_name) (rate(http_server_requests_total{deployment=~\"$deployment\", service_name=~\"$service\", http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{deployment}} / {{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (deployment, service_name, le) (rate(http_server_request_duration_seconds_bucket{deployment=~\"$deployment\", service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{deployment}} / {{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Log volume (lines/s)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "logs" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (deployment, service_name) (rate({deployment=~\"$deployment\", service_name=~\"$service\"}[$__auto]))",
          "legendFormat": "{{deployment}} / {{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Recent logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "expr": "{deployment=~\"$deployment\", service_name=~\"$service\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
